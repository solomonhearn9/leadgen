# Copy to .env for local testing (Cursor, terminal, etc.) and fill in.
# .env is gitignored -- it's for your machine only. In GitHub Actions,
# these same values are set as repo secrets instead (see README).

ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
